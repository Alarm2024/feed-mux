# feed-mux — copy to .env and fill in values. Never commit real secrets.

# --- Core ---
# Loopback by default — admin/metrics HTTP stays local. Use 0.0.0.0 only for intentional public expose behind auth.
BIND_ADDR=127.0.0.1:8787
DRY_RUN=true
REDIS_URL=redis://:changeme-local-only@127.0.0.1:6379/0
REDIS_CHANNEL=feed:350
MOCK_PUBLISH_INTERVAL_SECS=30

# --- Upstream feature flags (stubs in dry-run; live when DRY_RUN=false) ---
ENABLE_CHAINSTACK=false
CHAINSTACK_RPC_URL=
CHAINSTACK_WS_URL=

# Helius backup RPC — used only when ENABLE_HELIUS=true and DRY_RUN=false.
# Set HELIUS_RPC_URL to your Helius HTTPS endpoint (include api-key in the URL).
ENABLE_HELIUS=false
HELIUS_RPC_URL=

# Triton gRPC — rate-limited independently from Titan.
# Used only when ENABLE_TRITON_GRPC=true and DRY_RUN=false.
# Set TRITON_GRPC_URL to your Triton gRPC endpoint.
ENABLE_TRITON_GRPC=false
TRITON_GRPC_URL=
TRITON_RATE_LIMIT_RPS=25

# Titan WebSocket — rate-limited independently from Triton.
# Used only when ENABLE_TITAN_WS=true, TITAN_WS_URL is set, and DRY_RUN=false.
# TITAN_WALLET_PUBKEY is required for live Titan: quotes are compiled for that account.
# Use the Bot 350 cheap_2 wallet pubkey ONLY — never a KEEP / Garden Angel wallet.
ENABLE_TITAN_WS=false
TITAN_WS_URL=
TITAN_WALLET_PUBKEY=
TITAN_RATE_LIMIT_RPS=15
# Local Titan WS relay for Bot 350 MUX_TITAN_BIND eyes probe (ws://127.0.0.1:19001).
TITAN_LOCAL_BIND=127.0.0.1:19001

# --- Logging ---
RUST_LOG=info,feed_mux=debug
